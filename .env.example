# +======================================================+
# |  x-tg-notify Credentials                             |
# |  Copy this to .env and fill in your values           |
# |  Or run: python3 bot.py --setup                      |
# +======================================================+

# -- X / Twitter ----------------------------------------
# How to get auth_token + ct0:
#   1. Open https://x.com in browser, log in
#   2. F12 -> Application -> Cookies -> x.com
#   3. Copy "auth_token" value (40-char hex)
#   4. Copy "ct0" value (long hex string)
X_AUTH_TOKEN=
X_CT0=

# X List to poll (one flat-cost poll across all members).
# Create a List on X (private is fine); ID is in the URL:
#   x.com/i/lists/<X_LIST_ID>
X_LIST_ID=

# -- Telegram -------------------------------------------
# Bot Token: open @BotFather, /newbot, copy token
#   (format: 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=
# Chat ID: message your bot, then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates
#   find "chat":{"id":XXXXX}
TELEGRAM_CHAT_ID=
