# ╔══════════════════════════════════════════════════════╗
# ║  x-tg-notify Credentials                            ║
# ║  Copy this to .env and fill in your values          ║
# ║  Or run: python3 bot.py --setup                     ║
# ╚══════════════════════════════════════════════════════╝

# ── X / Twitter ────────────────────────────────────────
# How to get:
#   1. Open https://x.com in browser, log in
#   2. F12 → Application → Cookies → x.com
#   3. Copy "auth_token" value (40-char hex)
X_AUTH_TOKEN=
#   4. Copy "ct0" value (long hex string)
X_CT0=

# ── Telegram ───────────────────────────────────────────
# How to get Bot Token:
#   1. Open @BotFather on Telegram
#   2. Send /newbot, follow instructions
#   3. Copy the token (format: 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=
# How to get Chat ID:
#   1. Send any message to your bot
#   2. Visit: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   3. Find "chat":{"id":XXXXX} — paste that number
TELEGRAM_CHAT_ID=
